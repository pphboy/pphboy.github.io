# Default for a Linux client connecting to Core on the same computer.
# Windows clients must use the reachable Linux Core HTTP/HTTPS origin.
# Values are unquoted for Compose and docker run --env-file compatibility.
PIWORK_CORE_URL=http://host.docker.internal:7171
PIWORK_CONFIG_PATH=/var/lib/piwork/client/credentials.json
PIWORK_CLI_CONTAINER_MODE=1
# For a custom HTTPS CA, copy the CA into /exchange and recreate the CLI.
# SSL_CERT_FILE=/exchange/core-ca.pem
