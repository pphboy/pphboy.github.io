# For Docker Compose. Fill the complete administrator and model groups.
# release.env supplies the fixed image references.
# Single-quote secrets to preserve dollar signs. Do not source this file.
PIWORK_DATA_DIR=/var/lib/piwork/core
PIWORK_LISTEN=0.0.0.0:7171
PIWORK_AGENT_GRPC_LISTEN=0.0.0.0:7172
PIWORK_AGENT_GRPC_ADVERTISE=piwork-core:7172
PIWORK_ADMIN_ACCOUNT=''
PIWORK_ADMIN_PASSWORD=''
PIWORK_MODEL_PROVIDER=''
PIWORK_MODEL=''
PIWORK_API_KEY=''
# Optional. Omit to use the SDK endpoint; do not set an empty value.
# Remote custom model endpoints must be reachable HTTPS URLs.
# PIWORK_MODEL_BASE_URL='https://your-model-endpoint/v1'
