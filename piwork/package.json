{
  "name": "piwork-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "node scripts/check-content.mjs && node scripts/check-demos.mjs && vitepress build docs",
    "preview": "vitepress preview docs",
    "test:deploy": "node --test scripts/deploy.test.mjs",
    "deploy": "node scripts/deploy.mjs piwork docs/.vitepress/dist",
    "check:content": "node scripts/check-content.mjs",
    "check:demos": "node scripts/check-demos.mjs",
    "test:demos": "node --test scripts/demo-search.test.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
